# Copy to .env and replace every value before running `docker compose up`.
# .env is git-ignored. Never commit real secrets.

DB_USERNAME=claimsphere
DB_PASSWORD=change-me

# At least 32 random bytes, e.g. generated with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-of-at-least-32-bytes

# 'demo' seeds 7 users (admin, manager, 2 officers, 3 claimants), 4 policies in 3 markets and
# 5 claims in different states. All demo accounts share DEMO_PASSWORD.
SPRING_PROFILES_ACTIVE=demo
DEMO_PASSWORD=change-me-demo

CORS_ALLOWED_ORIGINS=http://localhost:4200
